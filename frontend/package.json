{
  "name": "bruise-web-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n BE,FE -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "..\\backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --env-file ../backend/.env --port 8000 --host 127.0.0.1 --reload --app-dir ../backend",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build && xcopy dist ..\\backend\\static /E /I /Y",
    "prod": "npm run build:prod && ..\\backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --env-file ../backend/.env --port 8000 --host 127.0.0.1 --app-dir ../backend",
    "preview": "vite preview",
    "test": "node --test tests/analysis-details.test.cjs tests/history.test.cjs tests/ui.test.cjs",
    "test:browser": "node tests/history.browser.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
