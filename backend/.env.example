# Copy to .env; never commit real values.
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/bruise_db"
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
# development: local HTTP only. production: HTTPS and Secure cookies are mandatory.
AUTH_ENV=development
# Optional persistent path; defaults to backend/.auth/state.sqlite3
# AUTH_STATE_PATH=/private/persistent/auth.sqlite3
